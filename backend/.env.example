# StockIQ Backend Environment Configuration Example
PROJECT_NAME=StockIQ API
VERSION=1.0.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL 16 + pgvector with automatic local SQLite fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockiq
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stockiq
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockiq
ALLOW_SQLITE_FALLBACK=true
SEED_DEFAULT_DATA=true
AUTH_FALLBACK_DB=./.stockiq_auth.db

# Security & Authentication (JWT)
SECRET_KEY=generate-a-secure-secret-key-for-production-min-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8501,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8501,http://127.0.0.1:3000

# Market Data Providers
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_API_KEY=

# LLM Providers for RAG, SEBI Chatbot & Financial Education
LLM_PROVIDER=gemini
GEMINI_API_KEY=
CLAUDE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model (RAG)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Email Notifications
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=StockIQ Alerts <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=

# Optional demo administrator: provision explicitly with python -m app.scripts.seed_admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
