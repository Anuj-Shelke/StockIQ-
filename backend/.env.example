# Application
PROJECT_NAME=StockIQ API
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security & JWT
# IMPORTANT: Generate a secure 256-bit random key for production
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:8501,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8501,http://127.0.0.1:3000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://stockiq_user:stockiq_pass@localhost:5432/stockiq_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=stockiq_user
POSTGRES_PASSWORD=stockiq_pass
POSTGRES_DB=stockiq_db

# Supabase (Optional / Hybrid)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External APIs
MARKET_DATA_API_KEY=
LLM_API_KEY=
EMAIL_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=StockIQ Alerts <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
SEED_DEFAULT_DATA=false
ALLOW_SQLITE_FALLBACK=false
AUTH_FALLBACK_DB=./.stockiq_auth.db
