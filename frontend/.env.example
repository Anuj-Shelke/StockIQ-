# Base URL of the FastAPI backend (no trailing slash). Only used when the mock is off.
VITE_API_URL=http://localhost:8000

# Frontend-only mode. In `npm run dev` the app serves /api/v1/auth/* and /api/v1/dashboard from an
# in-browser mock by default, so no backend is needed. Set to false once the FastAPI backend implements
# those endpoints. Always ignored (off) in production builds.
VITE_AUTH_MOCK=false
