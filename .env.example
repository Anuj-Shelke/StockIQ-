# Environment Mode
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockiq
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stockiq
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockiq

# Security & Authentication (JWT)
SECRET_KEY=generate-a-secure-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Market Data Providers
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_API_KEY=

# LLM Providers for RAG & Chatbot
LLM_PROVIDER=gemini
GEMINI_API_KEY=
CLAUDE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model (RAG)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Email Notifications (Post-MVP)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
FROM_EMAIL=noreply@stockiq.ai
